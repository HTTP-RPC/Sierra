<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE column-panel SYSTEM "sierra.dtd">

<column-panel spacing="8" padding="8" opaque="true">
    <row-panel spacing="16" border="silver" padding="16" opaque="true" background="white" weight="1">
        <spacer weight="1"/>
        <activity-indicator name="activityIndicator1" indicatorStyle="small"/>
        <activity-indicator name="activityIndicator2" indicatorStyle="medium"/>
        <activity-indicator name="activityIndicator3" indicatorStyle="large"/>
        <spacer weight="1"/>
    </row-panel>

    <row-panel>
        <spacer weight="1"/>
        <toggle-button name="toggleButton" text="active"/>
        <spacer weight="1"/>
    </row-panel>
</column-panel>

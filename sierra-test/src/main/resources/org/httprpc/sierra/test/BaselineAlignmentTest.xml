<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE table-panel SYSTEM "sierra.dtd">

<table-panel columnCount="2" alignToBaseline="true" padding="8" opaque="true">
    <row-panel alignToBaseline="true" spacing="4" border="silver" padding="4">
        <label text="abcdefg" font="small" border="silver"/>
        <label text="hijk" font="large" border="silver"/>

        <spacer size="20, 20" border="silver"/>

        <column-panel spacing="4" border="silver, 1, dotted" padding="8">
            <label text="abcdefg" font="medium" border="silver"/>
            <label text="hijk" font="small" border="silver"/>
        </column-panel>

        <row-panel alignToBaseline="true" spacing="4" border="silver, 1, dotted" padding="8">
            <label text="abcd" font="large" border="silver"/>
            <label text="efg" font="medium" border="silver"/>
            <label text="hijk" font="small" border="silver"/>
        </row-panel>
    </row-panel>

    <label text="lmnop" font="medium" border="silver"/>
</table-panel>
